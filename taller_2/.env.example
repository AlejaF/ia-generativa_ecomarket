# Copia este archivo a .env y completa SOLO lo que vayas a usar.
# Sin ninguna clave el sistema usa el modelo local (lento y de menor calidad).

# auto (defecto: Groq si hay GROQ_API_KEY, si no el modelo local) | groq | local
LLM_PROVIDER=auto

# Groq: crea una cuenta en https://console.groq.com y genera una clave en API Keys
GROQ_API_KEY=

# Modelo del proveedor elegido (vacío = el modelo por defecto del proveedor)
LLM_MODEL=

# 1 = el verificador de reglas decide las devoluciones; 0 = decide el LLM
USE_RULES=1

# 1 = usar el almacén de certificados del sistema (Windows/macOS) para verificar el HTTPS.
# Actívalo solo si ves "CERTIFICATE_VERIFY_FAILED ... self signed certificate in certificate chain",
# típico de antivirus, VPN o proxy que interceptan el HTTPS. No desactiva la verificación.
# truststore ya está en requirements.txt
USE_SYSTEM_CERTS=0

# Pausa (segundos) entre llamadas al LLM en las evaluaciones, para respetar límites
LLM_PAUSE_S=20
